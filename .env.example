# Cooky environment variables (docs/SETUP_KEYS.md).
# Copy to .env.local for development. Validated in src/server/env.ts.
# Local dev and `pnpm build` work with everything empty; deployed builds
# (VERCEL_ENV=preview|production) refuse to boot without the required ones.
# Set COOKY_STRICT_ENV=1 to rehearse the deployed check locally.

# ── Client (the COMPLETE public allow-list; anything else reaching the browser is a bug) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000   # canonical https origin in production
NEXT_PUBLIC_PUSHER_KEY=                     # Phase 6: realtime chat
NEXT_PUBLIC_PUSHER_CLUSTER=                 # e.g. eu; also opens that cluster in the CSP
NEXT_PUBLIC_VAPID_PUBLIC_KEY=               # Phase 6: web push
NEXT_PUBLIC_SENTRY_DSN=                     # error tracking; off when empty

# ── Server: used from Phase 0 ──
LOG_LEVEL=info
DATABASE_URL=                               # Neon pooled connection string (runtime)
DATABASE_URL_UNPOOLED=                      # Neon direct connection string (migrations)
SENTRY_AUTH_TOKEN=                          # build-time source map upload only

# ── Server: declared in env.ts when their phase ships ──
BETTER_AUTH_SECRET=                         # Phase 1 · openssl rand -base64 48 · never rotate casually
BETTER_AUTH_URL=                            # Phase 1 · same origin as NEXT_PUBLIC_APP_URL
CRON_SECRET=                                # Phase 1 · openssl rand -hex 32
GOOGLE_CLIENT_ID=                           # Phase 1
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=                            # Phase 1 · optional
APPLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=                          # Phase 2
STRIPE_WEBHOOK_SECRET=                      # pnpm stripe:listen prints it locally
STRIPE_AUTOMATIC_TAX=off                    # on once Stripe Tax is set up (needs a business address)
UPSTASH_REDIS_REST_URL=                     # Phase 1 · burst limits, weather cache
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=                               # Phase 1 · outbox, schedules, timer alerts
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
RESEND_API_KEY=                             # Phase 1 · email
EMAIL_FROM=                                 # "Cooky <hello@yourdomain>"
R2_ACCOUNT_ID=                              # Phase 3 · photos, avatars, exports
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PUSHER_APP_ID=                              # Phase 6
PUSHER_SECRET=
VAPID_PRIVATE_KEY=                          # Phase 6 · never rotate without a migration plan
VAPID_SUBJECT=                              # mailto:you@yourdomain
GROQ_API_KEY=                               # Phase 3–4 · AI (optional)
OPENAI_API_KEY=
AI_CHAT_MODEL=
AI_FALLBACK_MODEL=
AI_TRANSCRIBE_MODEL=
OPEN_METEO_API_KEY=                         # Phase 4 · commercial plan required
POSTHOG_KEY=                                # optional, server-side only
POSTHOG_HOST=
